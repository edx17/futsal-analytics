# Copiá este archivo como .env y completá los valores.
# Todo lo que empieza con VITE_ viaja al navegador: NO pongas secretos acá.
# Las mismas variables tienen que estar cargadas en Vercel (Settings →
# Environment Variables), si no funcionan en tu máquina y en producción no.

VITE_SUPABASE_URL=https://TU-PROYECTO.supabase.co
VITE_SUPABASE_ANON_KEY=

# Clave PÚBLICA del par VAPID, para las notificaciones push de la campanita.
# Sin esto el botón "Activar notificaciones" falla siempre con
# "Falta la clave VITE_VAPID_PUBLIC_KEY".
# Se genera con:  npx web-push generate-vapid-keys
# La pública va acá; la PRIVADA va como secreto del Edge Function
# (supabase secrets set VAPID_PRIVATE_KEY=...), nunca en el frontend.
VITE_VAPID_PUBLIC_KEY=

# ── COBRO DE LA SUSCRIPCIÓN ────────────────────────────────────────────────
# Los datos con los que te pagan los clubes. Van acá y no en el código porque
# el repositorio es público: el alias y el nombre del titular quedarían
# visibles en GitHub y en el historial para siempre.
# Lo que quede vacío no se muestra en "Mi Suscripción".
VITE_COBRO_ALIAS=
VITE_COBRO_CBU=
VITE_COBRO_TITULAR=

# Links de pago de Mercado Pago, opcionales (la transferencia no tiene
# comisión, así que es la vía principal). Se crean UNA vez en el panel de MP
# por plan y ciclo, son fijos y los reutiliza cualquiera.
VITE_MP_DT_MENSUAL=
VITE_MP_DT_ANUAL=
VITE_MP_CT_MENSUAL=
VITE_MP_CT_ANUAL=
VITE_MP_CLUB_MENSUAL=
VITE_MP_CLUB_ANUAL=
